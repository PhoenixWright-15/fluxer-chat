# =============================================================================
# Fluxer Chat — Backend Environment Variables
# =============================================================================
# Copy this file to .env for local development.
# In production, these are set via Render dashboard and GitHub Secrets.
# =============================================================================

# Neon PostgreSQL connection string
# Get this from: Neon Dashboard → Your Project → Connection Details
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://fluxer_user:your_password@ep-xxxxx.us-east-2.aws.neon.tech/fluxer_db?sslmode=require

# CORS origin — the domain your frontend is served from
# For GitHub Pages: https://<username>.github.io/<repo-name>
# For local dev:    http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Server port (Render uses 10000 for free tier)
PORT=10000

# Node environment
NODE_ENV=development

# JWT Secret (auto-generated in render.yaml, set manually for local dev)
JWT_SECRET=change-me-to-a-random-string
